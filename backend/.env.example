# === GauRakshak backend configuration ===
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file. NEVER put these values in the Flutter app.

# App
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Database — SQLite for local dev; swap for Postgres/Supabase URL in production
# PostgreSQL example for the local setup guide (port 9856):
# postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:9856/mastitis_db
# Or use the project database name on the standard port:
# postgresql+psycopg://user:password@host:5432/gaurakshak
DATABASE_URL=sqlite:///./gaurakshak.db

# Auth — generate a long random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_use_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM API key for GauSaathi — stays ONLY on the backend, never in the app
GAUSAATHI_LLM_API_KEY=sk-CHANGE_ME
# Optional OpenAI-compatible service settings. Keep real values in .env only.
GAUSAATHI_LLM_BASE_URL=https://provider.example/v1
GAUSAATHI_LLM_MODEL=your-chat-model

# CORS — comma-separated allowed origins (tighten in production)
CORS_ORIGINS=http://localhost,http://localhost:3000
